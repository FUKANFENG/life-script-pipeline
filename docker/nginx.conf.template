map "${XG_API_KEY}" $xg_authorization {
    "" "";
    default "Bearer ${XG_API_KEY}";
}

server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 32m;
    # Token queries and signed image URLs must not enter the access log.
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
    location = /config.js {
        add_header Cache-Control "no-store";
    }
    location /canvas-agent/ {
        set $agent_upstream http://agent:17371;
        rewrite ^/canvas-agent/(.*)$ /$1 break;
        proxy_pass $agent_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location /xg-api/ {
        set $xg_upstream "${XG_API_BASE_URL}";
        rewrite ^/xg-api/(.*)$ /$1 break;
        proxy_pass $xg_upstream;
        proxy_set_header Authorization $xg_authorization;
        proxy_ssl_server_name on;
        proxy_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
