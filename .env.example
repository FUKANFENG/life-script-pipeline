# Docker Compose runtime settings. Do not commit .env or copy an old key here.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
XG_API_BASE_URL=http://host.docker.internal:18080
XG_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com

# CPU is portable and requires no NVIDIA GPU. See docker-compose.gpu.yml for CUDA.
LOCAL_ALIGNER_DEVICE=cpu
